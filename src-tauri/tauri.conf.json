{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xkyhold-lx",
  "identifier": "com.xkyriver.xkyhold-lx",
  "build": {
    "beforeDevCommand": "npm run dev --workspace ui",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build --workspace ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "XkyHold-lx",
        "width": 960,
        "height": 720,
        "minWidth": 400,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ],
    "publisher": "XKYRIVER",
    "homepage": "https://xkyhold.xkyriver.com/linux/",
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "shortDescription": "Encrypted backup of your home folder",
    "longDescription": "XkyHold-lx backs up your home folder, or the parts you choose, to your Google Drive or to a folder such as an external disk. Everything is encrypted on your computer before it leaves it.",
    "linux": {
      "deb": {
        "depends": [],
        "recommends": [
          "libnotify-bin",
          "gnome-keyring"
        ],
        "section": "utils",
        "desktopTemplate": "../packaging/xkyhold-lx.desktop",
        "files": {
          "/usr/share/metainfo/com.xkyriver.xkyhold-lx.metainfo.xml": "../packaging/com.xkyriver.xkyhold-lx.metainfo.xml"
        }
      },
      "rpm": {
        "recommends": [
          "libnotify",
          "gnome-keyring"
        ],
        "desktopTemplate": "../packaging/xkyhold-lx.desktop",
        "files": {
          "/usr/share/metainfo/com.xkyriver.xkyhold-lx.metainfo.xml": "../packaging/com.xkyriver.xkyhold-lx.metainfo.xml"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/metainfo/com.xkyriver.xkyhold-lx.appdata.xml": "../packaging/com.xkyriver.xkyhold-lx.metainfo.xml"
        }
      }
    }
  }
}
