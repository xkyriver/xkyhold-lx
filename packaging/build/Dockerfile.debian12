# Release builds of XkyHold-lx on Debian 12 (glibc 2.36), so the packages run
# without warnings on Debian 12, Ubuntu 22.04 and newer (docs/UPDATES.md 9).
# Used by scripts/build-in-debian.
FROM debian:12

ARG RUST=1.100.0
ARG NODE=26.8.1

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl file git pkg-config xz-utils \
      libwebkit2gtk-4.1-dev libgtk-3-dev libsoup-3.0-dev librsvg2-dev \
      libayatana-appindicator3-dev libssl-dev libxdo-dev \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo PATH=/usr/local/cargo/bin:/usr/local/node/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain "$RUST" \
    && rustc --version
RUN curl -sSfL "https://nodejs.org/dist/v$NODE/node-v$NODE-linux-x64.tar.xz" | tar -xJ -C /usr/local \
    && mv "/usr/local/node-v$NODE-linux-x64" /usr/local/node && node --version

# linuxdeploy is an AppImage; containers have no FUSE.
ENV APPIMAGE_EXTRACT_AND_RUN=1
WORKDIR /src
